{
  "name": "lead-trade-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "监控币安带单员的订单流，生成可手动跟单的信号",
  "engines": {
    "node": ">=22.21"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "NODE_USE_ENV_PROXY=1 HTTPS_PROXY=${HTTPS_PROXY:-http://127.0.0.1:7890} tsx src/entry/run.ts",
    "once": "NODE_USE_ENV_PROXY=1 HTTPS_PROXY=${HTTPS_PROXY:-http://127.0.0.1:7890} tsx src/entry/once.ts",
    "replay": "tsx src/entry/replay.ts",
    "stats": "tsx src/entry/stats.ts"
  },
  "dependencies": {
    "p-retry": "^8.0.1",
    "yaml": "^2.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
